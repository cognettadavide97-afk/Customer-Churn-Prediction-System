+        mean_f2 = float(np.mean(cv_res["test_f2"]))
+        mean_auc = float(np.mean(cv_res["test_roc_auc"]))
+        overfit_gap = max(0.0, float(np.mean(cv_res["train_f2"]) - mean_f2))
